{
  "name": "@exegetical/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev --env local --ip 127.0.0.1",
    "prepare:corpus": "node scripts/index-corpus.mjs",
    "prebuild": "npm run build --workspace @exegetical/web",
    "test:full": "vitest run --config vitest.full.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@exegetical/corpus": "*",
    "@exegetical/shared": "*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "effect": "3.22.4",
    "zod": "4.6.7"
  }
}
